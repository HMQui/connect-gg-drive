# ==============================================================================
# CẤU HÌNH API SERVER & BẢO MẬT
# ==============================================================================
PORT=8000
API_SECRET_KEY=my_super_secret_postman_key

# Thư mục lưu trữ file trên server (nơi file kéo về hoặc lấy file để đẩy lên)
LOCAL_SYNC_DIR=./data/gdrive_sync

# Chọn chế độ xác thực: "oauth2" hoặc "service_account" (để trống hoặc "auto" thì tự nhận diện)
AUTH_METHOD=auto

# ID thư mục Google Drive dùng chung (lấy từ URL trên trình duyệt)
GDRIVE_FOLDER_ID=1u3ZFTWVvbRwXwFfCvjMcpBPxfxuDwZFK

# ==============================================================================
# [CÁCH 1] XÁC THỰC BẰNG GOOGLE SERVICE ACCOUNT
# Dành cho: Google Workspace (Shared Drive) hoặc chỉ dùng để tải về (PULL)
# ==============================================================================
# Đường dẫn tới file credentials JSON đã tải từ Google Cloud
GDRIVE_SA_JSON_PATH=./credentials/service-account.json

# (Tùy chọn) Nội dung JSON được mã hóa Base64
GDRIVE_SA_JSON_BASE64=

# (Tùy chọn) Chỉ điền nếu dùng Bộ nhớ dùng chung (Shared Drive) của Google Workspace / Edu
GDRIVE_TEAM_DRIVE_ID=

# ==============================================================================
# [CÁCH 2] XÁC THỰC BẰNG OAUTH 2.0 REFRESH TOKEN (KHUYÊN DÙNG CHO DRIVE CÁ NHÂN)
# Dành cho: Tài khoản Google cá nhân (@gmail.com) - Hỗ trợ cả PUSH và PULL
# ==============================================================================
# Chuỗi JSON Token sinh ra từ lệnh: .\rclone.exe authorize "drive"
# Ví dụ: {"access_token":"ya29...","token_type":"Bearer","refresh_token":"1//04...","expiry":"2026-..."}
GDRIVE_OAUTH_TOKEN=

# (Tùy chọn) Điền nếu bạn tự tạo OAuth Client ID riêng trên GCP, nếu không có hãy để trống
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
